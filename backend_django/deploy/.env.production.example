SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-STRING
DEBUG=False

# Render backend domain(s), comma-separated if you add a custom domain.
ALLOWED_HOSTS=your-service-name.onrender.com

# Frontend URL deployed on Vercel.
FRONTEND_URL=https://your-vercel-app.vercel.app

# Keep CORS/CSRF aligned with your frontend URL.
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app

# Render PostgreSQL connection string (set in Render dashboard).
# DATABASE_URL=postgres://...

# Brevo SMTP (replace with your own values)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=465
BREVO_SMTP_USER=your-brevo-user
BREVO_SMTP_PASSWORD=your-brevo-password
BREVO_FROM_EMAIL=noreply@yourdomain.com